generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  emailVerified    DateTime?
  role             Role             @default(BRAND)
  subscriptionTier String?
  usageLimits      Int              @default(10)
  name             String?
  onboarded        Boolean          @default(false)
  productCategory  String?
  storefrontPlatform String?
  catalogSize      String?
  hashedPassword   String?
  status           UserStatus @default(ACTIVE)
  suspendedAt      DateTime?
  statusReason     String?
  projects         Project[]
  assets           Asset[]
  analyticsEvents  AnalyticsEvent[]
  revisionRequests RevisionRequest[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  BRAND
  ADMIN
}

model Project {
  id            String           @id @default(cuid())
  name          String
  sku           String?
  instructions  String?
  dimensions    Json?
  status        ProjectStatus    @default(PENDING)
  sdkConfig     Json?
  brandId       String
  brand         User             @relation(fields: [brandId], references: [id])
  analytics     AnalyticsEvent[]
  assets        Asset[]
  revisionRequests RevisionRequest[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([brandId])
}

enum ProjectStatus {
  PENDING
  REVISIONS
  COMPLETED
  PUBLISHED
}

model RevisionRequest {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note        String
  requestedBy String
  requester   User     @relation(fields: [requestedBy], references: [id])
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model Token {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  type       String
  expires    DateTime
  createdAt  DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType EventType
  sessionId String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  brandId   String
  brand     User     @relation(fields: [brandId], references: [id])
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([brandId])
}

enum EventType {
  VIEW
  INTERACTION
  AR_LAUNCH
}

enum AssetType {
  REFERENCE_IMAGE
  MODEL_GLB
  MODEL_USDZ
}

enum AssetStatus {
  UPLOADING
  READY
  PUBLISHED
  ARCHIVED
  DELETED
}

model Asset {
  id            String      @id @default(cuid())
  projectId     String?
  ownerId       String
  type          AssetType
  status        AssetStatus @default(UPLOADING)
  provider      String      @default("uploadthing")
  key           String
  url           String
  originalName  String
  mimeType      String
  size          Int
  checksum      String?
  backupSynced  Boolean     @default(false)
  gdriveFileId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  project       Project?    @relation(fields: [projectId], references: [id])
  owner         User        @relation(fields: [ownerId], references: [id])

  @@index([projectId])
  @@index([ownerId])
}
