generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  email           String           @unique
  emailVerified   DateTime?
  role            Role             @default(BRAND)
  stripeCustomerId String?
  subscriptionTier String?
  usageLimits     Int              @default(10)
  name            String?
  onboarded       Boolean          @default(false)
  hashedPassword  String?
  projects        Project[]
  analyticsEvents AnalyticsEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum Role {
  BRAND
  ADMIN
}

model Project {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  sku           String?
  instructions  String?
  dimensions    Json?
  status        ProjectStatus    @default(PENDING)
  referenceUrls String[]         // R2 URLs for JPGs
  assetUrls     Json?            // { glb: string, usdz: string }
  sdkConfig     Json?            // { scale: [1,1,1], autoRotate: true, shadow: 0.8, etc }
  brandId       String           @db.ObjectId
  brand         User             @relation(fields: [brandId], references: [id])
  assignedTo    String?          @db.ObjectId
  analytics     AnalyticsEvent[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([brandId])
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  PUBLISHED
}

model Token {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  type       String
  expires    DateTime
  createdAt  DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventType EventType
  sessionId String
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id])
  brandId   String   @db.ObjectId
  brand     User     @relation(fields: [brandId], references: [id])
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([brandId])
}

enum EventType {
  VIEW
  INTERACTION
  AR_LAUNCH
}
